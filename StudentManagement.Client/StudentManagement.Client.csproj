    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.13.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\StudentManagement.Shared\StudentManagement.Shared.csproj" />
  </ItemGroup>

</Project>
