@page "/student-dashboard"
@using Microsoft.AspNetCore.Authorization
@* @attribute [Authorize] *@
@using StudentManagement.Shared
@using StudentManagement.Client.Service
@inject StudentService _studentService
@inject IJSRuntime JS
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>🎓 Student Dashboard</h3>
    <NavLink class="btn btn-primary" href="/add-student">➕ Add Student</NavLink>
</div>

@if (students == null)
{
    <p><em>Loading student data...</em></p>
}
else if (!students.Any())
{
    <div class="alert alert-warning">No students found.</div>
}
else
{
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>FirstName</th>
                <th>LastName</th>
                <th>Roll No</th>
                <th>Address</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in students)
            {
                <tr>
                    <td>@student.FirstName</td>
                    <td>@student.LastName</td>
                    <td>@student.RollNo</td>
                    <td>@student.Address</td>
                    <td>
                        <button class="btn btn-warning btn-sm" @onclick="@(() => EditStudent(student))">Edit</button>
                        <button class="btn btn-danger btn-sm" @onclick="() => DeleteStudent(student.StudentId)">Delete</button>

                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (studentToEdit != null)
{
    <hr />
    <CascadingValue Value="studentToEdit">
        <UpdateStudentComponent OnUpdateCompleted="ClearEdit" />
    </CascadingValue>
}

@code {
    private IEnumerable<Student> students = new List<Student>();
    private Student? studentToEdit;

    protected override async Task OnInitializedAsync()
    {
        students = await _studentService.GetAllStudent();
    }

    private void EditStudent(Student student)
    {
        studentToEdit = student;
    }

    private void ClearEdit()
    {
        studentToEdit = null;
    }

    private async Task DeleteStudent(int studentId)
    {
        var confirm = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete student ?");
        if (confirm)
        {
            var success = await _studentService.DeleteStudent(studentId);
            if (success)
            {
                // Refresh the student list
                students = await _studentService.GetAllStudent();
            }
        }
    }
}
